#!/bin/bash
set -Eeuo pipefail

ADMIN_USER=admin
ADMIN_PASS=turnkey
ADMIN_MAIL=admin@example.com

WEBROOT=/usr/share/dokuwiki
CONF=/etc/dokuwiki
STATE=/var/lib/dokuwiki
WIKINAME="TurnKey Linux DokuWiki"

test -f "$WEBROOT/VERSION"
dpkg-query -W dokuwiki >/dev/null

# Keep packaged application code immutable and configure only Debian's
# persistent configuration and state locations.
cat > "$CONF/local.php" <<EOF
<?php
\$conf['title'] = '$WIKINAME';
\$conf['license'] = 'cc-by-sa';
\$conf['useacl'] = 1;
\$conf['superuser'] = '@admin';
\$conf['userewrite'] = 1;
\$conf['useslash'] = 1;
\$conf['xsendfile'] = 2;
EOF
chown root:root "$CONF/local.php"
chmod 0644 "$CONF/local.php"

ADMIN_HASH=$(openssl passwd -1 "$ADMIN_PASS")
printf '%s:%s:%s:%s:%s\n' \
    "$ADMIN_USER" "$ADMIN_HASH" "$ADMIN_USER" "$ADMIN_MAIL" \
    'admin,user' > "$STATE/acl/users.auth.php"
chown www-data:root "$STATE/acl/users.auth.php"
chmod 0600 "$STATE/acl/users.auth.php"

# apache configuration
a2dissite 000-default
a2disconf dokuwiki || true
a2enmod ssl
a2enmod headers
a2ensite dokuwiki
a2enmod rewrite

# set dokuwiki permissions (anonymous: create, authenticated: upload)
cat > "$STATE/acl/acl.auth.php" <<EOF
*                     @ALL        4
*                     @user       8
EOF
chown www-data:root "$STATE/acl/acl.auth.php"
chmod 0600 "$STATE/acl/acl.auth.php"

# welcome page
STARTPAGE=$STATE/data/pages/start.txt
cat > "$STARTPAGE" <<EOF
====== Getting started ======

  * Log in as **admin** and start your wiki!
  * Refer to the [[https://www.turnkeylinux.org/dokuwiki|TurnKey DokuWiki release notes]]
  * [[wiki:syntax|Wiki Syntax]]
  * [[wiki:dokuwiki|Local DokuWiki documentation]]
  * [[doku>manual|The official DokuWiki manual]]
EOF
chown www-data:root "$STARTPAGE"
chmod 0644 "$STARTPAGE"
